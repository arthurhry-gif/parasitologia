# Regras de Cache de Alta Performance

# Assets com hash imutáveis por 1 ano (JS, CSS e chunks gerados pelo Vite)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Imagens locais do diretório /images/ (guias e bônus) com cache de longa duração
/images/*
  Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

# Imagens estáticas otimizadas na raiz (WebP, PNG, JPG, SVG, ICO)
/*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.jpg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.ico
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# HTML sem cache agressivo para garantir que novos deploys sejam vistos instantaneamente
/index.html
  Cache-Control: public, max-age=0, must-revalidate
